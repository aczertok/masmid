rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's account (all their profiles and progress), and its daily backups: only they can read or write it.
    match /data/users/{uid}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // "Learn together": who is learning right now. Signed-in people can see the list; each person writes only their own entry.
    match /rooms/{room}/peers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['presence', 'ts', 'at'])
                            && request.resource.data.ts is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Learners: each profile's public card (first name, avatar, level, town). Signed-in people can read; you write only your own.
    match /community/{group}/people/{id} {
      allow read: if request.auth != null && group in ['man', 'woman', 'boy', 'girl'];
      allow create, update: if request.auth != null && group in ['man', 'woman', 'boy', 'girl']
                            && id.matches(request.auth.uid + '_.*')
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.keys().hasOnly(['card', 'uid', 'ts'])
                            && request.resource.data.card.size() < 60000;
      allow delete: if request.auth != null && id.matches(request.auth.uid + '_.*');
    }
    // High fives: anyone signed in can send one in their group; nobody can change or delete someone else's.
    match /community/{group}/fives/{fid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && group in ['man', 'woman', 'boy', 'girl']
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['to', 'from', 'uid', 'nick', 'ts'])
                    && request.resource.data.nick.size() <= 24;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
